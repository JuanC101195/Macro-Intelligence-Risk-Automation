# Copy to .env and fill in locally. Never commit .env.
# The app refuses to start on dangerous or ambiguous combinations (see docs/architecture.md §3).

APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ALLOW_DEMO_ORDERS=false

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

SYMBOLS=EURUSD,GBPUSD,USDJPY
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=M15

# Hard ceilings: risk per trade <= 0.005, daily loss <= 0.02
MAX_RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=5
MAX_SPREAD_POINTS=30
MAX_SLIPPAGE_POINTS=10

CRUCIX_BASE_URL=http://localhost:3117
CRUCIX_ENABLED=true
MACRO_REQUIRED=false
MACRO_MAX_AGE_MINUTES=30
MACRO_UNKNOWN_PENALTY=0.8

DATABASE_URL=sqlite:///./trading.db

API_KEY=
N8N_API_KEY=
N8N_BASE_URL=

LLM_API_KEY=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

LOG_LEVEL=INFO
LOG_JSON=false
